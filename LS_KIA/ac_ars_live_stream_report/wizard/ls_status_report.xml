<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="live_stream_status_report_wizard_form" model="ir.ui.view">
        <field name="name">live.stream.report.report.form</field>
        <field name="model">ls.utilization.report</field>
        <field name="arch" type="xml">
            <form string="Live Stream Report">
                <header>

                </header>
                <sheet>
                    <div style="margin-top: -2em;text-align: center;background: #002c5f;margin-left: -15px;width: 75em;">
                        <span>
                            <h3 style="color: white;">Hyundai India</h3>
                        </span>
                    </div>
                    <group col="4">
                        <label for="company_id" string="Current Dealer"/>
                        <div>
                            <field name="company_id" readonly="1"/>
                        </div>
                        <label for="user_id" string="Current User"/>
                        <div>
                            <field name="user_id" readonly="1"/>
                        </div>
                    </group>

                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                        </group>
                        <group>
                            <field name="to_date" required="1"/>
                        </group>
                    </group>
                    <div class="row mt16 o_settings_container" id="live_streaming_report_setup">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="dealers_list"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="Dealers List" for="dealers_list"/>
                                <div class="text-muted">

                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ls_dealers_list"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="Live Streaming Dealers" for="ls_dealers_list"/>
                                <div class="text-muted">

                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="region_wise_list"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="LS Region Wise" for="region_wise_list"/>
                                <div class="text-muted">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="zone_wise_list"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="LS Zone Wise" for="zone_wise_list"/>
                                <div class="text-muted">
                                </div>
                            </div>
                        </div>
                    </div>
                    <group col="4" colspan="6">
                        <div style="padding: 15px;">
                            <h3>
                                <label for="expected_ls_per_day" string="Expected Live Streaming Number Per Day"
                                       style="font-weight: bold;"/>
                                <div>
                                    <field name="expected_ls_per_day" string="Expected Live Streaming Number"/>
                                </div>
                            </h3>
                        </div>
                        <div style="padding: 15px;">
                            <h3>
                                <label for="expected_working_days" string="Expected Working Days"
                                       style="font-weight: bold;"/>
                                <div>
                                    <field name="expected_working_days" string="Expected Working Days"/>
                                </div>
                            </h3>
                        </div>
                        <div style="padding: 15px;">
                            <h3>
                                <label for="expected_ls_link" string="Expected Live Streaming Link Per Dealer"
                                       style="font-weight: bold;"/>
                                <div>
                                    <field name="expected_ls_link"/>
                                </div>
                            </h3>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button class="oe_highlight" string="Print Report" name="print_xls_report" type="object"/>
                    or
                    <button class="oe_link" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="live_stream_status_report_wizard_action" model="ir.actions.act_window">
        <field name="name">LS Utilization Report</field>
        <field name="res_model">ls.utilization.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="live_stream_status_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="live_stream_status_report_menu"
              parent="ac_ars_cc_camera.ac_ars_live_streaming_reports_menu"
              sequence="4"
              action="live_stream_status_report_wizard_action"
              groups="ac_ars_cc_camera.live_stream_group_super"/>
</odoo>