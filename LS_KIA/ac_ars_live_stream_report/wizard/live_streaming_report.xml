<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="live_stream_report_wizard_form" model="ir.ui.view">
        <field name="name">live.stream.report.report.form</field>
        <field name="model">live.stream.report</field>
        <field name="arch" type="xml">
            <form string="Live Streaming Report">
                <sheet>

                    <h3>Hyundai India – Live Streaming Report</h3>

                    <!-- PERIOD SELECTION -->
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="year"
                                   invisible="period_type == 'date'"/>
                        </group>

                        <group>
                            <field name="month"
                                   invisible="period_type != 'month'"/>

                            <field name="quarter"
                                   invisible="period_type != 'quarter'"/>
                        </group>
                    </group>

                    <!-- CUSTOM DATE RANGE -->
                    <group invisible="period_type != 'date'">
                        <group>
                            <field name="from_date"/>
                        </group>
                        <group>
                            <field name="to_date"/>
                        </group>
                    </group>

                    <separator string="Report Details"/>

                    <!-- USER / DEALER INFO -->
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <label for="dealer_count" string="Total Dealer Rollout Completed"/>
                            <field name="dealer_count" readonly="1"/>
                        </group>
                    </group>

                </sheet>

                <footer>
                    <button name="action_export_excel"
                            string="Export Excel"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="live_stream_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Live Stream Report</field>
        <field name="res_model">live.stream.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="live_stream_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="live_stream_report_menu"
              parent="ac_ars_cc_camera.ac_ars_live_streaming_reports_menu"
              sequence="5"
              action="live_stream_report_wizard_action"
              groups="ac_ars_cc_camera.live_stream_group_super"/>
</odoo>