<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="ac_ars_camera_records_list">
            <field name="name">AC ARS Camera Records List</field>
            <field name="model">ac.ars.camera.records</field>
            <field name="arch" type="xml">
                <list>
                    <field name="cam_name"/>
                    <field name="camera_id"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ac_ars_camera_records_form">
            <field name="name">AC ARS Camera Records Form</field>
            <field name="model">ac.ars.camera.records</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar"/>
                        <button name="start_recording" string="Start Record" type="object" class="btn-primary"
                                invisible="status != 'not_recording'"/>
                        <button name="stop_recording" string="Stop Record" type="object" class="btn-primary"
                                invisible="status != 'recording'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Wizard action reference goes here once modernized -->
                        </div>
                        <group>
                            <group>
                                <field name="cam_name"/>
                                <field name="camera_id"/>
                                <field name="cam_pid"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="duration"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                            </group>
                            <field name="error_exception" invisible="status != 'exception'"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="ac_ars_camera_records_kanban">
            <field name="name">AC ARS Camera Records Kanban</field>
            <field name="model">ac.ars.camera.records</field>
            <field name="arch" type="xml">
                <kanban class="" create="1">
                    <field name="company_id"/>
                    <field name="cam_brand"/>
                    <field name="camera_id"/>
                    <field name="status"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click oe_kanban_card d-flex flex-column" style="min-width: 250px;">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title fs-5">
                                            <field name="camera_id"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="cam_brand"/>
                                        </div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-3 mb-2">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="fw-bold me-2" style="width: 100px;">Cam Status:</span>
                                        <field name="cam_status" widget="badge" decoration-success="cam_status == 'online'" decoration-danger="cam_status == 'offline'"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="fw-bold me-2" style="width: 100px;">Recording:</span>
                                        <field name="status" widget="badge" decoration-info="status == 'recording'" decoration-success="status == 'recorded'" decoration-danger="status == 'exception'"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-auto border-top pt-2 mt-2">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <i class="fa fa-building-o me-1" title="Company"/><field name="company_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="ac_ars_camera_records_action_window">
            <field name="name">IP CAM Records</field>
            <field name="res_model">ac.ars.camera.records</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

  </data>
</odoo>