<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

        <record model="ir.module.category" id="ip_camera_access_right">
            <field name="name">ARS IP Camera</field>
            <field name="sequence">201</field>
            <field name="description">User access level for this module</field>
        </record>

        <record id="ip_camera_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="ip_camera_access_right"/>
        </record>

        <record id="ip_camera_group_manager" model="res.groups">
            <field name="name">Admin</field>
            <field name="implied_ids" eval="[(4, ref('ac_ars_ip_camera.ip_camera_group_user'))]"/>
            <field name="category_id" ref="ip_camera_access_right"/>
        </record>

        <record id="ip_camera_group_super_admin" model="res.groups">
            <field name="name">Super Admin</field>
            <field name="implied_ids" eval="[(4, ref('ac_ars_ip_camera.ip_camera_group_manager'))]"/>
            <field name="category_id" ref="ip_camera_access_right"/>
        </record>

        <record id="ip_camera_group_user_rule" model="ir.rule">
            <field name="name">Camera Access Rule</field>
            <field name="model_id" ref="model_ac_ars_ip_camera"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('ip_camera_group_user'))]"/>
        </record>

        <record id="ip_camera_records_group_user_rule" model="ir.rule">
            <field name="name">Camera Records Access Rule</field>
            <field name="model_id" ref="model_ac_ars_camera_records"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('ip_camera_group_user'))]"/>
        </record>

  </data>
</odoo>