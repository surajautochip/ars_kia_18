<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ac_ars_ip_camera.CustomPasswordField">
        <t t-if="props.readonly">
            <div class="d-flex align-items-center justify-content-between w-100 custom-password-wrapper" style="border-bottom: 1px solid #ccc; min-height: 24px; padding-bottom: 2px;">
                <span class="o_field_char text-truncate" t-esc="displayValue"/>
                <t t-if="hasValue">
                    <i role="button"
                       t-attf-class="fa {{ state.showPassword ? 'fa-eye-slash text-primary' : 'fa-eye text-muted' }}"
                       style="cursor: pointer; font-size: 0.95rem; margin-left: auto; padding-right: 2px;"
                       t-on-click.stop="togglePassword"
                       title="Toggle Visibility"/>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="d-flex align-items-center gap-2 w-100 position-relative custom-password-wrapper">
                <input
                    class="o_input"
                    t-att-id="props.id"
                    t-att-type="inputType"
                    t-att-placeholder="placeholder"
                    t-on-blur="onBlur"
                    t-ref="input"
                    style="border-bottom: 1px solid #ccc !important; --o-input-border-color: #ccc !important;"
                />
                <i role="button"
                   t-attf-class="fa {{ state.showPassword ? 'fa-eye-slash text-primary' : 'fa-eye text-muted' }}"
                   style="cursor: pointer; font-size: 0.95rem;"
                   t-on-click.stop="togglePassword"
                   title="Toggle Visibility"/>
            </div>
        </t>
    </t>
</templates>
