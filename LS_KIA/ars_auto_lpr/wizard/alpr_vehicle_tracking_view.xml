<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
	<record id="view_vehicle_tracking_form" model="ir.ui.view">
		<field name="name">vehicle.tracking.wizard.form</field>
		<field name="model">vehicle.tracking.wizard</field>
		<field name="arch" type="xml">
			<form string="Vehicle Tracking Report">
				<group>
					<group>
						<field name="vehicle_number"/>
					</group>
					<group></group>
				</group>
				<footer>
					<button string="Generate Report"
						class="btn-primary"
						name="vehicle_tracking_report"
						type="object"/>
					<button string="Cancel"
						class="btn-default"
						special="cancel" />
				</footer>
			</form>
		</field>
	</record>

	<record id="action_vehicle_tracking_wizard" model="ir.actions.act_window">
		<field name="name">Vehicle Tracking Report</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">vehicle.tracking.wizard</field>
		
		<field name="view_mode">form</field>
		<field name="view_id" ref="view_vehicle_tracking_form"/>
		<field name="target">new</field>
	</record>

  </data>
</odoo>