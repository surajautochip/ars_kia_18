<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <template id="report_bay_status">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>

                    <h3 class="text-center"><strong>Bay Status Report</strong></h3>

                    <table class="table table-bordered" style="font-size:11px;">
                        <thead>
                            <th>Location</th>
                            <t t-foreach="data.get('slot_time')" t-as="slot">
                                <th><span t-esc="slot"/></th>
                            </t>
                            <th>Total</th>
                        </thead>
                        <tbody>
                            <t t-set="bay_status" t-value="data.get('bay_status')"/>
                            <t t-foreach="data.get('bay_list')" t-as="location">
                                <t t-set="tot_vehicle" t-value="0"/>
                                <tr>
                                    <td><strong><span t-esc="location"/></strong></td>
                                    <t t-foreach="bay_status.get(str(location)).items()" t-as="bay">
                                        <td class="text-center"><span t-esc="bay[1]"/></td>
                                        <t t-set="tot_vehicle" t-value="tot_vehicle + bay[1]"/>
                                    </t>
                                    <td class="text-center"><span t-esc="tot_vehicle"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <report
        id="action_menu_bay_status"
        string="Bay Status Report"
        model="alpr.bay.vehicle.log"
        report_type="qweb-pdf"
        name="ars_auto_lpr.report_bay_status"
        file="ars_auto_lpr.report_bay_status"
        menu="False"/>

  </data>
</odoo>