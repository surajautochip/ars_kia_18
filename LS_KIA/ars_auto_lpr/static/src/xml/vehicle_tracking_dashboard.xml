<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ars_auto_lpr.VehicleTrackingDashboard" owl="1">
        <div class="o_vehicle_tracking_dashboard container-fluid p-4" style="background-color: #f0f0f0; min-height: 100vh;">
            
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 2px solid #ddd;">
                <h2 class="m-0 fw-bold" style="color: #4c4c4c;">Vehicle Location Tracking</h2>
                <div>
                    <button class="btn btn-primary shadow-sm rounded-0" t-on-click="fetchData">
                        <i class="fa fa-refresh me-2"></i> Refresh
                    </button>
                </div>
            </div>

            <div class="row g-4">
                <t t-if="state.bays.length === 0">
                    <div class="col-12">
                        <div class="alert alert-info rounded-0 shadow-sm">
                            <i class="fa fa-info-circle me-2"></i> No active dashboard locations found. Make sure you set 'Is Dashboard' on your resource categories.
                        </div>
                    </div>
                </t>
                <t t-foreach="state.bays" t-as="bay" t-key="bay.id">
                    <div class="col-12 col-md-4 col-lg-3">
                        <div class="card rounded-0 shadow-sm border-0 h-100" style="background-color: #7c7bad;">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                                <div class="text-white text-uppercase fw-bold text-center mb-3" style="font-size: 1.25rem; letter-spacing: 1px;">
                                    <t t-esc="bay.dashbord_name"/>
                                </div>
                                <div class="text-white fw-bolder" style="font-size: 3.5rem; line-height: 1;">
                                    <t t-esc="bay.count_value"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
