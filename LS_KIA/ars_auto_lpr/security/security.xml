<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">
		<record id="alpr_bay_vehicle_log_comp_rule" model="ir.rule">
	        <field name="name">Bay Log: Company Rule</field>
	        <field name="model_id" ref="model_alpr_bay_vehicle_log"/>
	        <field name="global" eval="True"/>
	        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
	    </record>



        <record model="ir.module.category" id="module_category_vehicle_tracking">
            <field name="name">Vehicle Tracking</field>
            <field name="description">Helps you manage your tracking related processes such as 
            	token configuration, camera configuration, bay mapping etc.</field>
            <field name="sequence">210</field>
        </record>

        <record id="group_vehicle_tracking_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_vehicle_tracking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_vehicle_tracking_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_vehicle_tracking"/>
            <field name="implied_ids" eval="[(4, ref('group_vehicle_tracking_user'))]"/>
            <field name="users" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_vehicle_tracking_server" model="res.groups">
            <field name="name">Server</field>
            <field name="category_id" ref="module_category_vehicle_tracking"/>
            <field name="implied_ids" eval="[(4, ref('group_vehicle_tracking_manager'))]"/>
            <field name="users" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>