<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

        <record id="alpr_mail_conf_tree" model="ir.ui.view">
            <field name="name">Alpr Mail Config</field>
            <field name="model">alpr.mail.conf</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>

        <record id="alpr_mail_conf_form" model="ir.ui.view">
            <field name="name">Alpr Mail Config</field>
            <field name="model">alpr.mail.conf</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Sent Mail"
                                class="btn-primary"
                                name="sent_mail"
                                type="object"/>
                        <button string="Cancel"
                                class="btn-default"
                                special="cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Name" class="oe_edit_only"/>
                            <h2>
                                <field name="name"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="email"/>
                                <field name="subject"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        <notebook>
                            <page name="Email Body" string="Email Body">
                                <field name="email_body"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="alpr_mail_conf_action_window">
            <field name="name">Alpr Mail Configuration</field>
            <field name="res_model">alpr.mail.conf</field>
            <field name="view_mode">list,form</field>
        </record>


  </data>
</odoo>