        <record id="resource_category_tree" model="ir.ui.view">
            <field name="name">resource.category</field>
            <field name="model">resource.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"></field>
                    <field name="code"></field>
                </list>
            </field>
        </record>
