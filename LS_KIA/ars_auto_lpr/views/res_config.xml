<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>


		<record id="view_num_plate_conf_form" model="ir.ui.view">
			<field name="name">Settings</field>
			<field name="model">alpr.config.settings</field>
			<field name="arch" type="xml">
				<form string="Configuration" class="oe_form_configuration">
					<header>
                        <button string="Apply" type="object" name="execute" class="oe_highlight"/>
                        <button string="Cancel" type="object" name="cancel" class="oe_link"/>
                    </header>
					<group>
						<group>
							<field name="evaluation_type" options="{'no_create': True}" class="oe_inline"/>
							<field name="token" required="evaluation_type == 'online_api'"/>
							<field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
						</group>
					</group>
				</form>
			</field>
		</record>

		<record id="action_num_plate_conf_form" model="ir.actions.act_window">
			<field name="name">Numplate Conf</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">alpr.config.settings</field>
			<field name="view_mode">form</field>
			<field name="target">inline</field>
		</record>


  </data>
</odoo>