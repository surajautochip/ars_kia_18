<odoo>
  <data>

        <record model="ir.ui.view" id="ls_ac_ars_allocation_data_list">
            <field name="name">Allocation Data</field>
            <field name="model">ac.ars.allocation.data</field>
            <field name="arch" type="xml">
                <list>
                    <field name="dms_ro_no"/>
                    <field name="partner_id"/>
                    <field name="resource_id"/>
                    <field name="date_start"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ls_ac_ars_allocation_data_form">
            <field name="name">Allocation Data</field>
            <field name="model">ac.ars.allocation.data</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" clickable="True"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1 class="o_row">
                                <field name="dms_ro_no" placeholder="RO Number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" options="{'no_quick_create':True, 'no_create_edit':True, 'no_create': True, 'create_edit': False}"/>
                                <field name="user_id" options="{'no_quick_create':True, 'no_create_edit':True, 'no_create': True, 'create_edit': False}"/>
                                <field name="company_id" options="{'no_quick_create':True, 'no_create_edit':True, 'no_create': True, 'create_edit': False}"/>
                            </group>
                            <group>
                                <field name="resource_id" options="{'no_quick_create':True, 'no_create_edit':True, 'no_create': True, 'create_edit': False}"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="ls_ac_ars_allocation_data_window">
            <field name="name">Allocation Data</field>
            <field name="res_model">ac.ars.allocation.data</field>
            <field name="view_mode">list,form</field>
            <!--            <field name="search_view_id" ref="ac_ars_live_streaming_search"/>-->
            <!--            <field name="context">{'search_default_group_by_company': True}</field>-->
        </record>

        <record id="ls_action_view_task" model="ir.actions.act_window">
            <field name="name">Live Stream Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
            <field name="context">{'search_default_my_tasks': 1}</field>
            <field name="search_view_id" ref="project.view_task_search_form"/>
            <field name="help" type="html">
                <p>
                    Hyundai Live streaming vehicle allocation console
                </p>
            </field>
        </record>


  </data>
</odoo>