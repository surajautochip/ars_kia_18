<odoo>
  <data>

        <record model="ir.ui.view" id="live_stream_report_list">
            <field name="name">Daily live stream report</field>
            <field name="model">ac.ars.live.stream.daily.report</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="date"/>
                    <field name="company_id"/>
                    <field name="link_sent"/>
                    <field name="viewed_link"/>
                    <field name="not_viewed_link"/>
                    <field name="total_no_bay"/>
                    <field name="tot_cus_viewed_time"/>
                    <field name="camera_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="live_stream_report_form">
            <field name="name">Daily live stream report</field>
            <field name="model">ac.ars.live.stream.daily.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="company_id"/>
                                <field name="link_sent"/>
                                <field name="viewed_link"/>
                                <field name="not_viewed_link"/>
                                <field name="total_no_bay"/>
                                <field name="camera_ids" widget="many2many_tags"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="live_stream_report_window">
            <field name="name">Daily live stream report</field>
            <field name="res_model">ac.ars.live.stream.daily.report</field>
            <field name="view_mode">list,form</field>
            <!--            <field name="search_view_id" ref="ac_ars_live_streaming_search"/>-->
            <!--            <field name="context">{'search_default_group_by_company': True}</field>-->
        </record>



  </data>
</odoo>