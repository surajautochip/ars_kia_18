<odoo>
  <data>

        <record model="ir.actions.act_window" id="ac_ars_live_streaming_graph_action">
            <field name="name">Streaming Graph</field>
            <field name="res_model">ac.ars.live.streaming</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="ac_ars_cc_camera.ac_ars_live_streaming_graph"></field>
        </record>
        <record model="ir.actions.act_window" id="ac_ars_live_streaming_pivot_action">
            <field name="name">Streaming Pivot</field>
            <field name="res_model">ac.ars.live.streaming</field>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="ac_ars_cc_camera.ac_ars_live_streaming_pivot"></field>
        </record>
        <record model="ir.ui.view" id="ac_ars_live_streaming_dashbord_form">
            <field name="name">Live Streaming</field>
            <field name="model">board.board</field>
            <field name="arch" type="xml">
                <form create="0">
                    <board style="1-2">
                        <column>
                            <action string="Live Streaming Graph" name="%(ac_ars_cc_camera.ac_ars_live_streaming_graph_action)d">
                            </action>
                        </column>
                        <column>
                            <action string="Live Streaming Pivot" name="%(ac_ars_cc_camera.ac_ars_live_streaming_pivot_action)d">
                            </action>
                        </column>
                    </board>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="ac_ars_live_streaming_dashbord_window">
            <field name="name">Live Streaming Dashbord</field>
            <field name="res_model">board.board</field>
            
            <!--            <field name="view_mode">form</field>-->
            <field name="usage">menu</field>
            <field name="view_id" ref="ac_ars_live_streaming_dashbord_form"></field>
            <!--            <field name="search_view_id" ref="ac_ars_live_streaming_search"/>-->
            <!--            <field name="context">{'search_default_group_by_company': True}</field>-->
        </record>
<!--        <menuitem name="Dashbord"-->
<!--                  id="ac_ars_live_streaming_dashbord"-->
<!--                  parent="ac_ars_cc_camera.ac_ars_live_streaming_records"-->
<!--                  sequence="1"-->
<!--                  action="ac_ars_live_streaming_dashbord_window"/>-->

  </data>
</odoo>