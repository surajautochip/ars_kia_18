<?xml version="1.0"?>
<odoo>
  <data>

        <record forcecreate="True" id="ir_cron_daily_report_create" model="ir.cron">
            <field name="name">Live Stream: Creating automated daily reports </field>
            <field name="model_id" ref="model_ac_ars_live_stream_token"/>
            <field name="state">code</field>
            <field name="code">model.cron_finish_live_stream()</field>
            <field  name="active" eval="True"/>
            <field name="user_id" ref="base.group_user"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

  </data>
</odoo>