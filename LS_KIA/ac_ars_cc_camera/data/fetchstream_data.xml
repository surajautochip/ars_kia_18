<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_live_stream_gateway_action" model="ir.cron">
            <field name="name">Live: FetchLiveStream Service</field>
            <field name="model_id" ref="model_ac_ars_live_streaming_settings"/>
            <field name="state">code</field>
            <field name="code">model.sheduler_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Active flag is set on fetchmail_server.create/write -->
            <field name="active" eval="True"/>
        </record>

        <record id="ir_ac_ars_schedule_mail_settings_action" model="ir.cron">
            <field name="name">Live Streaming: Scheduled Mail Sent</field>
            <field name="model_id" ref="model_ac_ars_schedule_mail_settings"/>
            <field name="state">code</field>
            <field name="code">model.cron_sheduler_send_mail()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Active flag is set on fetchmail_server.create/write -->
            <field name="active" eval="False"/>
        </record>

        <record id="ir_scheduler_server_configuration_action" model="ir.cron">
            <field name="name">Create: Server configuration</field>
            <field name="model_id" ref="model_ac_ars_live_streaming_settings"/>
            <field name="state">code</field>
            <field name="code">model.scheduler_create_server_configuration()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Active flag is set on fetchmail_server.create/write -->
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
