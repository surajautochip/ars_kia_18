<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
        <record id="view_region_streaming_report" model="ir.ui.view">
            <field name="name">region.streaming.report.from</field>
            <field name="model">region.streaming.report</field>
            <field name="arch" type="xml">
                <form string="Region Streaming Excel Report">
                    <div>
                        <group col="2">
                            <field name="company_id" options="{'no_open': True,'no_create': True,'no_create_edit': True}"/>
                            <field name="is_region"/>
                            <field name="region_id" invisible="is_region == False" required="is_region != False"/>
                        </group>
                        <group col="4">
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                        </group>
                    </div>
                    <footer>
                        <button string="Generate Report" class="btn-primary" name="region_streaming_print_report" type="object"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_region_streaming_report" model="ir.actions.act_window">
            <field name="name">Region Streaming Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">region.streaming.report</field>
            
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_region_streaming_report"/>
            <field name="target">new</field>
        </record>
  </data>
</odoo>