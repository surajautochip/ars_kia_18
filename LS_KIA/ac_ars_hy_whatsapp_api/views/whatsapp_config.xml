<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>

        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="ac_ars_hy_whatsapp_api_log_list">
            <field name="name">WhatsApp Configuration</field>
            <field name="model">ac.ars.whatsapp.config</field>
            <field name="arch" type="xml">
                <list>
                    <field name="company_id"/>
                    <field name="url"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ac_ars_hy_whatsapp_api_log_form">
            <field name="name">WhatsApp Configuration Form</field>
            <field name="model">ac.ars.whatsapp.config</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" clickable="False"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id"/>
                                <field name="url"/>
                            </group>
                            <group>
                                <field name="key" password="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Message Template" name="message_template">
                                <field name="temp_name"/>
                            </page>
                            <page string="Failure Reason" name="exception" invisible="state != 'exception'">
                                <label for="exception" string="Exception"/>
                                <field name="exception"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="hy_whatsapp_config_action_window">
            <field name="name">WhatsApp Configuration</field>
            <field name="res_model">ac.ars.whatsapp.config</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- Top menu item -->
