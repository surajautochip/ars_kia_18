        <menuitem name="Server to list" id="ac_ars_hy_whatsapp_api" parent="ac_ars_hy_whatsapp_api.menu_2"
                  action="ac_ars_hy_whatsapp_api.action_server"/>
        -->

  </data>
</odoo>